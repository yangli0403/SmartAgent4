# ===== SmartAgent4 本地调试环境配置 =====
# 使用说明：将本文件复制为 .env，并按注释填写实际值
# cp .env.local.example .env

# ── 数据库配置 ──────────────────────────────────────────────
# 本地 PostgreSQL 连接字符串，按实际情况修改用户名/密码/库名
DATABASE_URL=postgresql://smartagent:smartagent123@localhost:5432/smart_agent

# ── JWT 密钥 ─────────────────────────────────────────────────
# 本地调试可使用任意字符串，生产环境请换成强随机密钥
JWT_SECRET=local-dev-secret-key-change-me

# ── LLM 配置 ─────────────────────────────────────────────────
# 使用 Manus LLM 代理（与沙盒相同）
OPENAI_API_KEY=sk-6t4xNhVfCthTaPNMyNL56f
OPENAI_BASE_URL=https://api.manus.im/api/llm-proxy/v1
# 如需使用原生 OpenAI，注释上面两行，改用：
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── 认证配置 ─────────────────────────────────────────────────
# 本地调试跳过 OAuth，直接使用匿名用户
SKIP_AUTH=true
VITE_SKIP_OAUTH=true

# ── 情感系统 ─────────────────────────────────────────────────
# 本地若无 emotions 微服务，设为 false 可跳过
EMOTIONS_SYSTEM_ENABLED=false

# ── DashScope（语音/多模态，可选）────────────────────────────
DASHSCOPE_API_KEY=sk-a2e4c4f89f9f4fccb8b2a3309339b923

# ── LangSmith 追踪（可选，调试用）────────────────────────────
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_PROJECT=SmartAgent4

# ── 服务端口 ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── 默认人格 ─────────────────────────────────────────────────
DEFAULT_CHARACTER_ID=xiaozhi

# ── 新闻数据（newsdata.io）───────────────────────────────────
NEWSDATA_API_KEY=pub_4e0317d089aa45dda5a3f079b5afed59

# ── 高德地图 ─────────────────────────────────────────────────
AMAP_API_KEY=401b370b868b35e3fe834a21d1cade8a

# ── 飞书 officeAgent ─────────────────────────────────────────
FEISHU_APP_ID=cli_a97aaa0a1f3d1ccc
FEISHU_APP_SECRET=ZvjiTFG5LhWd4UWu4mubuhi6zcIwDDaN
